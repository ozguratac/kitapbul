<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/kSablon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp">

        <WebView
            android:id="@+id/kresimWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignBottom="@+id/kresim"
            android:layout_alignLeft="@+id/kresim"
            android:layout_alignRight="@+id/kresim"
            android:layout_alignTop="@+id/kresim"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/kresim"
            android:layout_width="82dp"
            android:layout_height="120dp"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:background="#e8e8e8"
            android:clickable="true"
            android:scaleType="fitXY"
            android:visibility="visible" />

        <TextView
            android:id="@+id/kfiyat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/kresim"
            android:layout_centerHorizontal="true"
            android:text="21.15 TL"
            android:textColor="@android:color/black"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/kitapSil"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignBottom="@+id/kresim"
            android:layout_alignRight="@+id/kresim"
            android:alpha="0.8"
            android:background="@android:color/background_light"
            app:srcCompat="@drawable/sepetsil" />

    </RelativeLayout>
</RelativeLayout>