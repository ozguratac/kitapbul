<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"

    android:background="#FFFFFF"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/altMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"
        android:background="#ececec">

        <com.google.android.gms.ads.AdView

            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/white"
            android:visibility="visible"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-4061139306454785/9803091808"></com.google.android.gms.ads.AdView>

        <LinearLayout
            android:id="@+id/menuliste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/adView"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical|fill_horizontal"
            android:orientation="horizontal">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center_vertical|center_horizontal"
                android:onClick="kitaplikToAnasayfa"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    ads:srcCompat="@drawable/homepng" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|center_horizontal"
                    android:text="ANASAYFA"
                    android:textSize="10sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    ads:srcCompat="@drawable/kitaplikalt" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|center_horizontal"
                    android:text="KİTAPLIK"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center_vertical|center_horizontal"
                android:onClick="kitaplikToBarkod"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    ads:srcCompat="@drawable/barkodalt" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|center_horizontal"
                    android:text="BARKOD"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center_vertical|center_horizontal"
                android:onClick="kitaplikToSepet"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    ads:srcCompat="@drawable/sepetalt" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|center_horizontal"
                    android:text="SEPET"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/kitaplikUst"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@android:color/darker_gray"
        android:visibility="invisible"
        tools:visibility="invisible">

        <ImageView
            android:id="@+id/kitapliklogo"
            android:layout_width="25dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            app:srcCompat="@drawable/kitapliklogo" />

        <TextView
            android:id="@+id/kitaplikBaslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/kitapliklogo"
            android:text="Kitaplarım"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kitaplikKitapSayi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="..."
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/kitaplikListeKaydir"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/altMenu"
        android:layout_below="@id/ustMenuKAtman">

        <LinearLayout
            android:id="@+id/kitaplikListe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"></LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/ustMenuKAtman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/menuler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/m1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="hepsiGoster"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ustMenu1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|center_vertical"
                    android:text="HEPSİ"
                    android:textColor="#2B2A2A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:typeface="sans" />

                <ImageView
                    android:id="@+id/cizgi1"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_weight="2"
                    android:scaleType="fitXY"
                    ads:srcCompat="@drawable/kalin">

                </ImageView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/m2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:onClick="okunanGoster"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ustMenu2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|center_vertical"
                    android:text="OKUDUKLARIM"
                    android:textColor="#4E4D4D"
                    android:textSize="11sp"
                    android:typeface="sans" />

                <ImageView
                    android:id="@+id/cizgi2"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    ads:srcCompat="@drawable/ince">

                </ImageView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/m3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:onClick="okunmayanGoster"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ustMenu3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal|center_vertical"
                    android:text="OKUMADIKLARIM"
                    android:textColor="#4E4D4D"
                    android:textSize="11sp"
                    android:typeface="sans" />

                <ImageView
                    android:id="@+id/cizgi3"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    ads:srcCompat="@drawable/ince">

                </ImageView>

            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <WebView
        android:id="@+id/kitaplikWeb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible" />

    <RelativeLayout
        android:id="@+id/kitapDetay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/altMenu"
        android:background="#FFFFFF"
        android:visibility="invisible"
        tools:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/kitapDetayKaydir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/resimKatman"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F69B9B">

                    <ImageView
                        android:id="@+id/kitapDetayResim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="50dp"
                        android:layout_marginTop="30dp"
                        android:scaleType="centerCrop"
                        ads:srcCompat="@drawable/boskitap" />

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:scaleType="fitXY"
                        ads:srcCompat="@drawable/gecis" />

                    <ImageView
                        android:id="@+id/kitapSilButon"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_alignBottom="@id/kitapDetayResim"
                        android:layout_alignParentLeft="false"
                        android:layout_alignParentRight="false"
                        android:layout_alignRight="@id/kitapDetayResim"
                        android:layout_marginBottom="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        ads:srcCompat="@drawable/copyeni" />


                    <ImageView
                        android:id="@+id/kitapAraButon"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_alignBottom="@id/kitapDetayResim"
                        android:layout_alignParentLeft="false"
                        android:layout_alignParentRight="false"
                        android:layout_alignLeft="@id/kitapDetayResim"
                        android:layout_marginBottom="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        ads:srcCompat="@drawable/kbul" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/kitapDetayAd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="5dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center_horizontal"
                    android:text="ŞEHVETİYE TARİKATI"
                    android:textColor="#000000"
                    android:textSize="21sp"
                    android:textStyle="normal|bold" />

                <TextView
                    android:id="@+id/kitapDetayYazar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_horizontal"
                    android:text="İsmail SAYMAZ"
                    android:textColor="#2B2A2A"
                    android:textSize="16sp"
                    android:textStyle="normal|bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:background="#6E6D6D">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="1px"
                        android:layout_marginTop="1px"
                        android:background="#FFFFFF"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp"
                        android:paddingTop="10dp">

                        <ImageView
                            android:id="@+id/imageView8"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:scaleType="fitEnd"
                            ads:srcCompat="@drawable/okudum" />

                        <ImageView
                            android:id="@+id/imageView9"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:scaleType="fitStart"
                            ads:srcCompat="@drawable/okumadim" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/kitapdetayAciklama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:gravity="fill_horizontal"
                    android:justificationMode="inter_word"
                    android:text="İsmail SAYMAZ asdasd adad sad sadas dsa dsad sad asdsa dsad as  sadsaddsad asdsa dasdasdsa dasdasdas dsa dsadsa dsa dsad sadsa dsadsa "
                    android:textAlignment="viewStart"
                    android:textColor="#2B2A2A"
                    android:textSize="12sp"
                    android:textStyle="normal" />

            </LinearLayout>
        </ScrollView>

    </RelativeLayout>

</RelativeLayout>